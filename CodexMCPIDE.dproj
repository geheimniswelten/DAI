<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <ProjectGuid>{92253D1E-D0B0-4ABB-8035-E7B117D4123C}</ProjectGuid>
    <ProjectVersion>20.4</ProjectVersion>
    <FrameworkType>None</FrameworkType>
    <MainSource>CodexMCPIDE.dpk</MainSource>
    <Base>True</Base>
    <Config Condition="'$(Config)'==''">Release</Config>
    <Platform Condition="'$(Platform)'==''">Win32</Platform>
    <TargetedPlatforms>3</TargetedPlatforms>
    <AppType>Package</AppType>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Base)'!=''">
    <DCC_Namespace>System;Xml;Data;Datasnap;Web;Soap;Winapi;Vcl;Vcl.Imaging;Vcl.Touch;Vcl.Samples;$(DCC_Namespace)</DCC_Namespace>
    <DCC_DcuOutput>.\Build\$(Platform)\$(Config)\Dcu</DCC_DcuOutput>
    <DCC_DcpOutput>.\Build\$(Platform)\$(Config)\Dcp</DCC_DcpOutput>
    <DCC_BplOutput>.\Build\$(Platform)\$(Config)\Bpl</DCC_BplOutput>
    <DCC_UnitSearchPath>Source;$(DCC_UnitSearchPath)</DCC_UnitSearchPath>
    <DCC_ExeOutput>.\Build\$(Platform)\$(Config)\Bpl</DCC_ExeOutput>
    <DCC_ImplicitBuild>False</DCC_ImplicitBuild>
    <DCC_Description>Codex MCP server integration for the Delphi 13 IDE</DCC_Description>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Platform)'=='Win32'">
    <DCC_Namespace>Winapi;System.Win;Data.Win;Datasnap.Win;Web.Win;Soap.Win;Xml.Win;Vcl;$(DCC_Namespace)</DCC_Namespace>
    <VerInfo_IncludeVerInfo>true</VerInfo_IncludeVerInfo>
    <VerInfo_Locale>1031</VerInfo_Locale>
    <VerInfo_Keys>CompanyName=CIMPCS GmbH;FileDescription=Codex MCP for Delphi IDE;FileVersion=1.0.0.0;InternalName=CodexMCPIDE;LegalCopyright=Copyright © 2026;OriginalFilename=CodexMCPIDE.bpl;ProductName=Codex MCP for Delphi IDE;ProductVersion=1.0.0</VerInfo_Keys>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Platform)'=='Win64'">
    <DCC_Namespace>Winapi;System.Win;Data.Win;Datasnap.Win;Web.Win;Soap.Win;Xml.Win;Vcl;$(DCC_Namespace)</DCC_Namespace>
    <VerInfo_IncludeVerInfo>true</VerInfo_IncludeVerInfo>
    <VerInfo_Locale>1031</VerInfo_Locale>
    <VerInfo_Keys>CompanyName=CIMPCS GmbH;FileDescription=Codex MCP for Delphi IDE;FileVersion=1.0.0.0;InternalName=CodexMCPIDE;LegalCopyright=Copyright © 2026;OriginalFilename=CodexMCPIDE.bpl;ProductName=Codex MCP for Delphi IDE;ProductVersion=1.0.0</VerInfo_Keys>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Config)'=='Debug'">
    <DCC_Define>DEBUG;$(DCC_Define)</DCC_Define>
    <DCC_DebugInformation>true</DCC_DebugInformation>
    <DCC_LocalDebugSymbols>true</DCC_LocalDebugSymbols>
    <DCC_Optimization>false</DCC_Optimization>
    <DCC_RangeChecking>true</DCC_RangeChecking>
    <DCC_OverflowChecking>true</DCC_OverflowChecking>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Config)'=='Release'">
    <DCC_Define>RELEASE;$(DCC_Define)</DCC_Define>
    <DCC_DebugInformation>false</DCC_DebugInformation>
    <DCC_LocalDebugSymbols>false</DCC_LocalDebugSymbols>
    <DCC_Optimization>true</DCC_Optimization>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Platform)'=='Win32'">
    <Base_Win32>true</Base_Win32>
    <CfgParent>Base</CfgParent>
    <PlatformID>Win32</PlatformID>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Platform)'=='Win64'">
    <Base_Win64>true</Base_Win64>
    <CfgParent>Base</CfgParent>
    <PlatformID>Win64</PlatformID>
  </PropertyGroup>
  <ItemGroup>
    <DelphiCompile Include="$(MainSource)">
      <MainSource>MainSource</MainSource>
    </DelphiCompile>
    <DCCReference Include="Source\CodexMCP.Constants.pas"/>
    <DCCReference Include="Source\CodexMCP.Settings.pas"/>
    <DCCReference Include="Source\CodexMCP.Logger.pas"/>
    <DCCReference Include="Source\CodexMCP.Json.pas"/>
    <DCCReference Include="Source\CodexMCP.TextFiles.pas"/>
    <DCCReference Include="Source\CodexMCP.CodexRegistration.pas"/>
    <DCCReference Include="Source\CodexMCP.Threading.pas"/>
    <DCCReference Include="Source\CodexMCP.OTA.Common.pas"/>
    <DCCReference Include="Source\CodexMCP.OTA.Creators.pas"/>
    <DCCReference Include="Source\CodexMCP.OTA.Runtime.pas"/>
    <DCCReference Include="Source\CodexMCP.OTA.UserInteraction.pas"/>
    <DCCReference Include="Source\CodexMCP.OTA.Dispatcher.pas"/>
    <DCCReference Include="Source\CodexMCP.Protocol.pas"/>
    <DCCReference Include="Source\CodexMCP.Server.pas"/>
    <DCCReference Include="Source\CodexMCP.Host.pas"/>
    <DCCReference Include="Source\CodexMCP.Options.Frame.pas"/>
    <DCCReference Include="Source\CodexMCP.Options.Page.pas"/>
    <DCCReference Include="Source\CodexMCP.Wizard.pas"/>
    <DCCReference Include="Source\CodexMCP.Register.pas"/>
    <BuildConfiguration Include="Debug">
      <Key>Cfg_1</Key>
      <CfgParent>Base</CfgParent>
    </BuildConfiguration>
    <BuildConfiguration Include="Base">
      <Key>Base</Key>
    </BuildConfiguration>
    <BuildConfiguration Include="Release">
      <Key>Cfg_2</Key>
      <CfgParent>Base</CfgParent>
    </BuildConfiguration>
  </ItemGroup>
  <ProjectExtensions>
    <Borland.Personality>Delphi.Personality.12</Borland.Personality>
    <Borland.ProjectType>Package</Borland.ProjectType>
    <BorlandProject>
      <Delphi.Personality>
        <Source>
          <Source Name="MainSource">CodexMCPIDE.dpk</Source>
        </Source>
      </Delphi.Personality>
      <Platforms>
        <Platform value="Win32">True</Platform>
        <Platform value="Win64">True</Platform>
      </Platforms>
    </BorlandProject>
    <ProjectFileVersion>12</ProjectFileVersion>
  </ProjectExtensions>
  <Import Project="$(BDS)\Bin\CodeGear.Delphi.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Delphi.Targets')" />
  <Import Project="$(APPDATA)\Embarcadero\BDS\$(PRODUCTVERSION)\UserTools.proj" Condition="Exists('$(APPDATA)\Embarcadero\BDS\$(PRODUCTVERSION)\UserTools.proj')" />
</Project>
