<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <ProjectGuid>{E40E640E-DA11-4D13-A137-DA1000000001}</ProjectGuid>
        <MainSource>DAI.dpk</MainSource>
        <ProjectVersion>20.5</ProjectVersion>
        <FrameworkType>None</FrameworkType>
        <Base>True</Base>
        <Config Condition="'$(Config)'==''">Debug</Config>
        <Platform Condition="'$(Platform)'==''">Win32</Platform>
        <ProjectName Condition="'$(ProjectName)'==''">DAI</ProjectName>
        <TargetedPlatforms>3</TargetedPlatforms>
        <AppType>Package</AppType>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Config)'=='Base' or '$(Base)'!=''">
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="('$(Platform)'=='Win32' and '$(Base)'=='true') or '$(Base_Win32)'!=''">
        <Base_Win32>true</Base_Win32>
        <CfgParent>Base</CfgParent>
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="('$(Platform)'=='Win64' and '$(Base)'=='true') or '$(Base_Win64)'!=''">
        <Base_Win64>true</Base_Win64>
        <CfgParent>Base</CfgParent>
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="('$(Platform)'=='Win64x' and '$(Base)'=='true') or '$(Base_Win64x)'!=''">
        <Base_Win64x>true</Base_Win64x>
        <CfgParent>Base</CfgParent>
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Config)'=='Debug' or '$(Cfg_1)'!=''">
        <Cfg_1>true</Cfg_1>
        <CfgParent>Base</CfgParent>
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Config)'=='Release' or '$(Cfg_2)'!=''">
        <Cfg_2>true</Cfg_2>
        <CfgParent>Base</CfgParent>
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Base)'!=''">
        <DCC_E>false</DCC_E>
        <DCC_N>false</DCC_N>
        <DCC_S>false</DCC_S>
        <DCC_F>false</DCC_F>
        <DCC_K>false</DCC_K>
        <GenDll>true</GenDll>
        <GenPackage>true</GenPackage>
        <DCC_Namespace>System;Xml;Data;Datasnap;Web;Soap;$(DCC_Namespace)</DCC_Namespace>
        <DCC_CBuilderOutput>All</DCC_CBuilderOutput>
        <SanitizedProjectName>DAI</SanitizedProjectName>
        <DCC_ExeOutput>.\Build\$(Platform)\$(Config)\Bpl</DCC_ExeOutput>
        <DCC_BplOutput>.\Build\$(Platform)\$(Config)\Bpl</DCC_BplOutput>
        <DCC_DcuOutput>.\Build\$(Platform)\$(Config)\Dcu</DCC_DcuOutput>
        <DCC_DcpOutput>.\Build\$(Platform)\$(Config)\Dcp</DCC_DcpOutput>
        <VerInfo_Locale>1031</VerInfo_Locale>
        <DllSuffix>$(Auto)</DllSuffix>
        <DCC_OutputNeverBuildDcps>true</DCC_OutputNeverBuildDcps>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Base_Win32)'!=''">
        <DCC_UsePackage>vcl;rtl;vclimg;vclie;IndySystem;IndyProtocols;IndyCore;$(DCC_UsePackage)</DCC_UsePackage>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Base_Win64)'!=''">
        <DCC_UsePackage>vcl;rtl;vclimg;vclie;IndySystem;IndyProtocols;IndyCore;$(DCC_UsePackage)</DCC_UsePackage>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Cfg_1)'!=''">
        <DCC_Define>DEBUG;$(DCC_Define)</DCC_Define>
        <DCC_DebugDCUs>true</DCC_DebugDCUs>
        <DCC_Optimize>false</DCC_Optimize>
        <DCC_GenerateStackFrames>true</DCC_GenerateStackFrames>
        <DCC_DebugInfoInExe>true</DCC_DebugInfoInExe>
        <DCC_RemoteDebug>true</DCC_RemoteDebug>
        <DCC_IntegerOverflowCheck>true</DCC_IntegerOverflowCheck>
        <DCC_RangeChecking>true</DCC_RangeChecking>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Cfg_2)'!=''">
        <DCC_LocalDebugSymbols>false</DCC_LocalDebugSymbols>
        <DCC_Define>RELEASE;$(DCC_Define)</DCC_Define>
        <DCC_SymbolReferenceInfo>0</DCC_SymbolReferenceInfo>
        <DCC_DebugInformation>0</DCC_DebugInformation>
    </PropertyGroup>
    <ItemGroup>
        <DelphiCompile Include="$(MainSource)">
            <MainSource>MainSource</MainSource>
        </DelphiCompile>
        <DCCReference Include="rtl.dcp"/>
        <DCCReference Include="vcl.dcp"/>
        <DCCReference Include="vclimg.dcp"/>
        <DCCReference Include="vclie.dcp"/>
        <DCCReference Include="designide.dcp"/>
        <DCCReference Include="IndySystem.dcp"/>
        <DCCReference Include="IndyCore.dcp"/>
        <DCCReference Include="IndyProtocols.dcp"/>
        <DCCReference Include="Source\h5u.DAI.OTA.Threads.pas"/>
        <DCCReference Include="Source\h5u.DAI.OTA.Stack.pas"/>
        <DCCReference Include="Source\h5u.DAI.OTA.Messages.pas"/>
        <DCCReference Include="Source\h5u.DAI.IDE.Control.pas"/>
        <DCCReference Include="Source\h5u.DAI.IDE.Toolbar.pas"/>
        <DCCReference Include="Source\h5u.DAI.OTA.Designer.pas"/>
        <DCCReference Include="Source\h5u.DAI.OTA.Debugger.pas"/>
        <DCCReference Include="Source\h5u.DAI.Clients.Registration.pas"/>
        <DCCReference Include="Source\h5u.DAI.Clients.SafeFiles.pas"/>
        <DCCReference Include="Source\h5u.DAI.Clients.ConfigText.pas"/>
        <DCCReference Include="Source\h5u.DAI.Codex.Registration.pas"/>
        <DCCReference Include="Source\h5u.DAI.Consts.pas"/>
        <DCCReference Include="Source\h5u.DAI.IDE.Notifier.pas"/>
        <DCCReference Include="Source\h5u.DAI.Log.pas"/>
        <DCCReference Include="Source\h5u.DAI.MCP.Protocol.pas"/>
        <DCCReference Include="Source\h5u.DAI.MCP.Instance.pas"/>
        <DCCReference Include="Source\h5u.DAI.MCP.Server.pas"/>
        <DCCReference Include="Source\h5u.DAI.MCP.Sessions.pas"/>
        <DCCReference Include="Source\h5u.DAI.MCP.Tools.pas"/>
        <DCCReference Include="Source\h5u.DAI.Options.Frame.pas">
            <Form>DAIOptionsFrame</Form>
            <FormType>dfm</FormType>
            <DesignClass>TFrame</DesignClass>
        </DCCReference>
        <DCCReference Include="Source\h5u.DAI.Options.Page.pas"/>
        <DCCReference Include="Source\h5u.DAI.OTA.Build.pas"/>
        <DCCReference Include="Source\h5u.DAI.OTA.CodeInsight.pas"/>
        <DCCReference Include="Source\h5u.DAI.OTA.Files.pas"/>
        <DCCReference Include="Source\h5u.DAI.OTA.Helpers.pas"/>
        <DCCReference Include="Source\h5u.DAI.OTA.Creators.pas"/>
        <DCCReference Include="Source\h5u.DAI.OTA.ProjectOptions.pas"/>
        <DCCReference Include="Source\h5u.DAI.OTA.Projects.pas"/>
        <DCCReference Include="Source\h5u.DAI.OTA.Search.pas"/>
        <DCCReference Include="Source\h5u.DAI.Source.Regex.pas"/>
        <DCCReference Include="Source\h5u.DAI.Source.Search.pas"/>
        <DCCReference Include="Source\h5u.DAI.Source.View.pas"/>
        <DCCReference Include="Source\h5u.DAI.Windows.Inspection.pas"/>
        <DCCReference Include="Source\h5u.DAI.Permissions.Dialog.pas"/>
        <DCCReference Include="Source\h5u.DAI.Permissions.Manager.pas"/>
        <DCCReference Include="Source\h5u.DAI.Permissions.Store.pas"/>
        <DCCReference Include="Source\h5u.DAI.Process.pas"/>
        <DCCReference Include="Source\h5u.DAI.Register.pas"/>
        <DCCReference Include="Source\h5u.DAI.Runtime.pas"/>
        <DCCReference Include="Source\h5u.DAI.Settings.pas"/>
        <DCCReference Include="Source\h5u.DAI.Text.Encoding.pas"/>
        <DCCReference Include="Source\h5u.DAI.Types.pas"/>
        <DCCReference Include="Source\h5u.DAI.UI.pas"/>
        <DCCReference Include="Source\h5u.DAI.WinAPI.TCP.pas"/>
        <DCCReference Include="Source\h5u.DAI.Wizard.pas"/>
        <BuildConfiguration Include="Base">
            <Key>Base</Key>
        </BuildConfiguration>
        <BuildConfiguration Include="Debug">
            <Key>Cfg_1</Key>
            <CfgParent>Base</CfgParent>
        </BuildConfiguration>
        <BuildConfiguration Include="Release">
            <Key>Cfg_2</Key>
            <CfgParent>Base</CfgParent>
        </BuildConfiguration>
    </ItemGroup>
    <ProjectExtensions>
        <Borland.Personality>Delphi.Personality.12</Borland.Personality>
        <Borland.ProjectType>Package</Borland.ProjectType>
        <BorlandProject>
            <Delphi.Personality>
                <Source>
                    <Source Name="MainSource">DAI.dpk</Source>
                </Source>
                <Excluded_Packages>
                    <Excluded_Packages Name="$(BDSBIN)\dcloffice2k370.bpl">Microsoft Office 2000 Beispiele für gekapselte Komponenten für Automatisierungsserver</Excluded_Packages>
                    <Excluded_Packages Name="$(BDSBIN)\dclofficexp370.bpl">Microsoft Office XP Beispiele für gekapselte Komponenten für Automation Server</Excluded_Packages>
                </Excluded_Packages>
            </Delphi.Personality>
            <Platforms>
                <Platform value="Android">False</Platform>
                <Platform value="Android64">False</Platform>
                <Platform value="Win32">True</Platform>
                <Platform value="Win64">True</Platform>
                <Platform value="Win64x">False</Platform>
            </Platforms>
        </BorlandProject>
        <ProjectFileVersion>12</ProjectFileVersion>
    </ProjectExtensions>
    <Import Project="$(BDS)\Bin\CodeGear.Delphi.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Delphi.Targets')"/>
    <Import Project="$(APPDATA)\Embarcadero\$(BDSAPPDATABASEDIR)\$(PRODUCTVERSION)\UserTools.proj" Condition="Exists('$(APPDATA)\Embarcadero\$(BDSAPPDATABASEDIR)\$(PRODUCTVERSION)\UserTools.proj')"/>
    <Import Project="$(MSBuildProjectName).deployproj" Condition="Exists('$(MSBuildProjectName).deployproj')"/>
</Project>
