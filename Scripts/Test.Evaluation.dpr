  Check(MainThread.EvalCalls + MainThread.AddCalls = LBefore, 'Prepare only reads metadata.');
  LPrepared.Expression := 'SomeValue';
  LJson := TDAIEvaluationService.Evaluate(LPrepared);
  Check(Field(LJson, 'status') = 'ok', 'Synchronous evaluation succeeds.');
  Check(Field(LJson, 'result_address') = '0xFEDCBA9876543210', 'Address must not lose high bits.');
  Check(Field(LJson, 'result_value') = '4294967294', 'Unsigned Evaluate ResultVal.');
  Check(Field(LJson, 'can_modify') = 'true', 'CanModify output.');
  Check(Field(LJson, 'sdk_pending') = 'false', 'Synchronous operation retired.'); LJson.Free;
  Check(MainThread.Notifiers.Count = 0, 'Own synchronous notifier detached.');
  LRequest := Request; LRequest.SourceFile := 'Unit1.pas'; LRequest.Line := 17; LRequest.FormatSpecifiers := 'h';
  LRequest.SideEffects := 'properties'; LJson := TDAIEvaluationService.Evaluate(LRequest); LJson.Free;
  Check(MainThread.LastSource = 'Unit1.pas', 'Lexical filename passed.'); Check(MainThread.LastLine = 17, 'Lexical line passed.');
  Check(MainThread.LastFormat = 'h', 'ASCII format lifetime.'); Check(MainThread.LastSideEffects = esePropertiesOnly, 'Properties enum preserved.');
  LRequest.SideEffects := 'all'; LJson := TDAIEvaluationService.Evaluate(LRequest); LJson.Free;
  Check(MainThread.LastSideEffects = eseAll, 'All side effects enum.');
  MainThread.EvalText := 'abcdef'; LRequest := Request; LRequest.MaximumCharacters := 3;
  LJson := TDAIEvaluationService.Evaluate(LRequest); Check(Field(LJson, 'result_text') = 'abc', 'Bounded SDK buffer.');
  Check(Field(LJson, 'truncated') = 'true', 'SDK buffer truncation reported.'); LJson.Free;
