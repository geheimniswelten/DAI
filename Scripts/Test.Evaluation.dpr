  ResetThread; MainProcess.StateValue := psRunning;
  LBefore := MainThread.EvalCalls; LJson := TDAIEvaluationService.Evaluate(Request);
  Check(Field(LJson, 'reason_code') = 'process_running', 'Running process refused.'); LJson.Free;
  Check(MainThread.EvalCalls = LBefore, 'No forced stop/evaluation.'); MainProcess.StateValue := psStopped;
  LRequest := Request; LRequest.ProcessId := 999; LJson := TDAIEvaluationService.Evaluate(LRequest);
  Check(Field(LJson, 'reason_code') = 'process_not_found', 'Exact process selector.'); LJson.Free;
  LRequest := Request; LRequest.ThreadId := 999; LJson := TDAIEvaluationService.Evaluate(LRequest);
  Check(Field(LJson, 'reason_code') = 'thread_not_found', 'Exact thread selector.'); LJson.Free;
  MainThread.Owner := nil; LJson := TDAIEvaluationService.Evaluate(Request);
  Check(Field(LJson, 'reason_code') = 'thread_owner_mismatch', 'Ownership checked.'); LJson.Free; MainThread.Owner := MainProcess;
  LOriginal := DebuggerObject.Current; LProcess := TFakeProcess.Create; LProcess.Id := 42; LProcess.StateValue := psStopped;
  LThreadObject := TFakeThread.Create; LThreadObject.Id := 7; LThreadObject.Owner := LProcess;
  LProcess.Current := LThreadObject; LProcess.ThreadsValue := TArray<IOTAThread>.Create(LThreadObject);
  DebuggerObject.Current := LProcess; DebuggerObject.ProcessesValue := TArray<IOTAProcess>.Create(LProcess);
  LJson := TDAIEvaluationService.Evaluate(LPrepared);
  Check(Field(LJson, 'reason_code') = 'prepared_target_changed', 'PID reuse and interface change refused.'); LJson.Free;
  Check(LThreadObject.EvalCalls = 0, 'Recycled target never evaluated.');
  DebuggerObject.Current := LOriginal; DebuggerObject.ProcessesValue := TArray<IOTAProcess>.Create(LOriginal);
  LThreadObject.Owner := nil; LProcess.Current := nil; LProcess.ThreadsValue := nil;
  MainThread.EvalResult := erBusy; LJson := TDAIEvaluationService.Evaluate(Request);
  Check(Field(LJson, 'status') = 'busy', 'SDK busy preserved.'); Check(Field(LJson, 'retryable') = 'true', 'Busy retryable.');
  NullField(LJson, 'can_modify'); NullField(LJson, 'result_address'); NullField(LJson, 'result_size'); LJson.Free;
  MainThread.EvalResult := erError; MainThread.EvalText := 'SDK expression error'; LJson := TDAIEvaluationService.Evaluate(Request);
  Check(Field(LJson, 'status') = 'error', 'SDK error preserved.'); Check(Field(LJson, 'result_text') = 'SDK expression error', 'Error text retained.');
  NullField(LJson, 'result_value'); LJson.Free;
  ResetThread; MainThread.EvalResult := erDeferred; LJson := TDAIEvaluationService.Evaluate(Request);
