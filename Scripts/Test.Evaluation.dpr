  Check(Field(LJson, 'modify_attempted') = 'false', 'No setter called.'); LJson.Free;
  Check(MainThread.ModifyCalls = LBefore, 'Unmodifiable expression unchanged.');
  MainThread.CanModifyValue := True; LJson := TDAIEvaluationService.Modify(Request, '99');
  Check(Field(LJson, 'modified') = 'true', 'Fresh synchronous modify succeeded.');
  Check(Field(LJson, 'result_value') = '-42', 'Signed Modify ResultVal.'); LJson.Free;
  MainThread.Reentrant := True; LBefore := MainThread.ModifyCalls; LJson := TDAIEvaluationService.Modify(Request, '99');
  Check(Field(LJson, 'reason_code') = 'context_changed', 'Reentrancy rejects fragile last-expression target.'); LJson.Free;
  Check(MainThread.ModifyCalls = LBefore, 'No modify after nested evaluation.'); MainThread.Reentrant := False;
  MainThread.NotifyRunning := True; LJson := TDAIEvaluationService.Modify(Request, '99');
