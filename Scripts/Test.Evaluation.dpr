  LJson := TDAIEvaluationService.Evaluate(Request); Check(Field(LJson, 'reason_code') = 'thread_pending', 'Timed-out receiver remains reserved.'); LJson.Free;
  MainThread.Complete('SomeValue', 'late'); LJson := TDAIEvaluationService.Status(LId);
  Check(Field(LJson, 'status') = 'timed_out', 'Late result cannot overwrite timeout.'); Check(Field(LJson, 'sdk_pending') = 'false', 'Late receiver retired.'); LJson.Free;
  ResetThread; MainThread.CanModifyValue := False; LBefore := MainThread.ModifyCalls;
