  MainThread.DestroyAssociation;
  MainThread.ThrowAfterAdd := True; LJson := TDAIEvaluationService.Evaluate(Request); LId := Field(LJson, 'request_id');
  Check(Field(LJson, 'registration_uncertain') = 'true', 'Unknown registration reserved separately.');
