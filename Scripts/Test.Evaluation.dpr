program Test.Evaluation;
{$APPTYPE CONSOLE}
uses
  System.Classes, System.SysUtils, System.JSON, System.Generics.Collections,
  Winapi.Windows, ToolsAPI, h5u.DAI.OTA.Evaluation;
type
  TFakeThread = class(TInterfacedObject, IOTAThread)
    Id: Cardinal;
    Owner: IOTAProcess;
    StateValue: TOTAThreadState;
    EvalResult, ModifyResult: TOTAEvaluateResult;
    CanModifyValue, InlineCompletion, Reentrant, NotifyRunning, UnexpectedCompletion, RaiseEvaluate, RaiseModify: Boolean;
    StopInside, FailAdd, FailRemove, ThrowAfterAdd: Boolean;
    EvalText, LastExpression, LastSource, LastFormat, LastAssigned: string;
    LastLine, EvalCalls, ModifyCalls, AddCalls, RemoveCalls, NextIndex, MetadataAtEval: Integer;
    LastSideEffects: TOTAEvalSideEffects;
    Notifiers: TDictionary<Integer, IOTAThreadNotifier>;
    UncertainNotifiers: TList<IOTAThreadNotifier>;
    constructor Create;
    destructor Destroy; override;
    function GetOSThreadID: LongWord;
    function GetState: TOTAThreadState;
    function GetOwningProcess: IOTAProcess;
    function AddNotifier(const ANotifier: IOTAThreadNotifier): Integer;
    procedure RemoveNotifier(const AIndex: Integer);
    function Evaluate(const ExprStr: string; ResultStr: PChar; ResultStrSize: LongWord;
      out CanModify: Boolean; SideEffects: TOTAEvalSideEffects; FormatSpecifiers: PAnsiChar;
      out ResultAddr: TOTAAddress; out ResultSize, ResultVal: LongWord; FileName: string; LineNumber: Integer): TOTAEvaluateResult;
    function Modify(const ValueStr: string; ResultStr: PChar; ResultSize: LongWord; out ResultVal: Integer): TOTAEvaluateResult;
    procedure Complete(const AExpression, AText: string; const ACode: Integer = 0; const ALegacy: Boolean = False);
    procedure CompleteModify(const AExpression, AText: string; const ACode: Integer = 0);
    procedure DestroyAssociation;
  end;
  TFakeProcess = class(TInterfacedObject, IOTAProcess)
    Id: Cardinal;
    StateValue: TOTAProcessState;
    Current: IOTAThread;
    ThreadsValue: TArray<IOTAThread>;
    function GetOSProcessId: LongWord;
    function GetProcessState: TOTAProcessState;
    function GetCurrentThread: IOTAThread;
    function GetThreadCount: Integer;
    function GetThread(const AIndex: Integer): IOTAThread;
  end;
  TFakeDebugger = class(TInterfacedObject, IOTADebuggerServices)
    Current: IOTAProcess;
    ProcessesValue: TArray<IOTAProcess>;
    PumpThread: TFakeThread;
    PumpCalls: Integer;
    function GetCurrentProcess: IOTAProcess;
    function GetProcessCount: Integer;
    function GetProcess(const AIndex: Integer): IOTAProcess;
    procedure ProcessDebugEvents;
  end;
var
  Checks, MetadataCalls: Integer;
  MainThread: TFakeThread;
  MainProcess: TFakeProcess;
  DebuggerObject: TFakeDebugger;
procedure Check(const ACondition: Boolean; const AMessage: string);
begin Inc(Checks); if not ACondition then raise EInvalidOperation.Create(AMessage); end;
procedure SDKThread;
begin
  if GetCurrentThreadId <> MainThreadID then raise EInvalidOperation.Create('SDK called off IDE thread.');
end;
procedure Metadata;
begin SDKThread; Inc(MetadataCalls); end;
function Field(const AJson: TJSONObject; const AName: string): string;
var LValue: TJSONValue;
begin LValue := AJson.GetValue(AName); Check(LValue <> nil, 'Missing ' + AName); Result := LValue.Value; end;
procedure NullField(const AJson: TJSONObject; const AName: string);
begin Check(AJson.GetValue(AName) is TJSONNull, AName + ' must be null.'); end;
function Request(const AExpression: string = 'SomeValue'): TDAIEvaluationRequest;
begin Result := Default(TDAIEvaluationRequest); Result.Expression := AExpression; end;
constructor TFakeThread.Create;
begin
  inherited; Notifiers := TDictionary<Integer, IOTAThreadNotifier>.Create;
  UncertainNotifiers := TList<IOTAThreadNotifier>.Create;
  StateValue := tsStopped; EvalResult := erOK; ModifyResult := erOK; CanModifyValue := True; EvalText := '42';
end;
destructor TFakeThread.Destroy;
begin UncertainNotifiers.Free; Notifiers.Free; inherited; end;
function TFakeThread.GetOSThreadID: LongWord; begin Metadata; Result := Id; end;
function TFakeThread.GetState: TOTAThreadState; begin Metadata; Result := StateValue; end;
function TFakeThread.GetOwningProcess: IOTAProcess; begin Metadata; Result := Owner; end;
function TFakeThread.AddNotifier(const ANotifier: IOTAThreadNotifier): Integer;
begin
  SDKThread; Inc(AddCalls);
  if FailAdd then
  begin
    UncertainNotifiers.Add(ANotifier);
    raise EInvalidOperation.Create('Attach failed before evaluation.');
  end;
  Result := NextIndex; Inc(NextIndex); Notifiers.Add(Result, ANotifier);
  if ThrowAfterAdd then raise EInvalidOperation.Create('Registered notifier then failed.');
end;
procedure TFakeThread.RemoveNotifier(const AIndex: Integer);
begin
  SDKThread; Inc(RemoveCalls);
  if FailRemove then raise EInvalidOperation.Create('Detach failed.');
  Check(Notifiers.ContainsKey(AIndex), 'Only own valid notifier may be removed.'); Notifiers.Remove(AIndex);
end;
procedure WriteBuffer(const ABuffer: PChar; const ACapacity: Cardinal; const AText: string);
var LCount: Integer;
begin
  LCount := Length(AText);
  if Cardinal(LCount) > ACapacity then LCount := ACapacity;
  if LCount > 0 then Move(PChar(AText)^, ABuffer^, LCount * SizeOf(Char));
  if Cardinal(LCount) < ACapacity then ABuffer[LCount] := #0;
end;
function TFakeThread.Evaluate(const ExprStr: string; ResultStr: PChar; ResultStrSize: LongWord;
  out CanModify: Boolean; SideEffects: TOTAEvalSideEffects; FormatSpecifiers: PAnsiChar;
  out ResultAddr: TOTAAddress; out ResultSize, ResultVal: LongWord; FileName: string; LineNumber: Integer): TOTAEvaluateResult;
var LJson: TJSONObject; LNotifier: IOTAThreadNotifier;
begin
  SDKThread; Inc(EvalCalls); LastExpression := ExprStr; LastSource := FileName; LastLine := LineNumber;
  LastFormat := string(AnsiString(FormatSpecifiers)); LastSideEffects := SideEffects;
  if Reentrant then
  begin LJson := TDAIEvaluationService.Evaluate(Request('OtherExpression')); LJson.Free; end;
  if NotifyRunning then for LNotifier in Notifiers.Values.ToArray do LNotifier.ThreadNotify(nrRunning);
  if UnexpectedCompletion then Complete('OtherExpression', 'unrelated');
  if InlineCompletion then Complete(ExprStr, 'inline-result');
  if StopInside then TDAIEvaluationService.Shutdown;
  if RaiseEvaluate then raise EInvalidOperation.Create('Evaluation threw after entry.');
  CanModify := CanModifyValue; ResultAddr := $FEDCBA9876543210; ResultSize := 8; ResultVal := $FFFFFFFE;
  WriteBuffer(ResultStr, ResultStrSize, EvalText);
  MetadataAtEval := MetadataCalls;
  Result := EvalResult;
end;
function TFakeThread.Modify(const ValueStr: string; ResultStr: PChar; ResultSize: LongWord; out ResultVal: Integer): TOTAEvaluateResult;
begin
  SDKThread; Inc(ModifyCalls); LastAssigned := ValueStr;
  Check(MetadataCalls = MetadataAtEval, 'Provider getters must not run between fresh Evaluate and Modify.');
  Check(LastSideEffects = eseNone, 'Modify preflight must prohibit side effects.');
  if RaiseModify then raise EInvalidOperation.Create('Modify threw after entry.');
  WriteBuffer(ResultStr, ResultSize, 'assigned'); ResultVal := -42; Result := ModifyResult;
end;
procedure TFakeThread.Complete(const AExpression, AText: string; const ACode: Integer; const ALegacy: Boolean);
var LNotifier: IOTAThreadNotifier; LNotifier160: IOTAThreadNotifier160;
begin
  for LNotifier in Notifiers.Values.ToArray do
    if ALegacy then LNotifier.EvaluateComplete(AExpression, AText, True, $DEADBEEF, 4, ACode)
    else
    begin
      Check(Supports(LNotifier, IOTAThreadNotifier160, LNotifier160), '64-bit callback interface required.');
      LNotifier160.EvaluateComplete(AExpression, AText, True, TOTAAddress($FEDCBA9876543210), 8, ACode);
    end;
end;
procedure TFakeThread.CompleteModify(const AExpression, AText: string; const ACode: Integer);
var LNotifier: IOTAThreadNotifier;
begin for LNotifier in Notifiers.Values.ToArray do LNotifier.ModifyComplete(AExpression, AText, ACode); end;
procedure TFakeThread.DestroyAssociation;
var LNotifier: IOTAThreadNotifier;
begin
  for LNotifier in Notifiers.Values.ToArray do LNotifier.Destroyed;
  for LNotifier in UncertainNotifiers do LNotifier.Destroyed;
  Notifiers.Clear; UncertainNotifiers.Clear;
end;
function TFakeProcess.GetOSProcessId: LongWord; begin Metadata; Result := Id; end;
function TFakeProcess.GetProcessState: TOTAProcessState; begin Metadata; Result := StateValue; end;
function TFakeProcess.GetCurrentThread: IOTAThread; begin Metadata; Result := Current; end;
function TFakeProcess.GetThreadCount: Integer; begin Metadata; Result := Length(ThreadsValue); end;
function TFakeProcess.GetThread(const AIndex: Integer): IOTAThread; begin Metadata; Result := ThreadsValue[AIndex]; end;
function TFakeDebugger.GetCurrentProcess: IOTAProcess; begin Metadata; Result := Current; end;
function TFakeDebugger.GetProcessCount: Integer; begin Metadata; Result := Length(ProcessesValue); end;
function TFakeDebugger.GetProcess(const AIndex: Integer): IOTAProcess; begin Metadata; Result := ProcessesValue[AIndex]; end;
procedure TFakeDebugger.ProcessDebugEvents;
begin
  SDKThread; Inc(PumpCalls);
  if PumpThread <> nil then begin PumpThread.Complete(PumpThread.LastExpression, 'pumped-result'); PumpThread := nil; end;
end;
procedure Rejected(const ARequest: TDAIEvaluationRequest; const AModify: Boolean = False; const AValue: string = '1');
var LJson: TJSONObject; LFailed: Boolean;
begin
  LFailed := False;
  try
    if AModify then LJson := TDAIEvaluationService.Modify(ARequest, AValue) else LJson := TDAIEvaluationService.Evaluate(ARequest);
    LJson.Free;
  except on E: Exception do LFailed := True; end;
  Check(LFailed, 'Invalid request must fail.');
end;
procedure ResetThread;
begin
  MainThread.EvalResult := erOK; MainThread.ModifyResult := erOK; MainThread.CanModifyValue := True;
  MainThread.InlineCompletion := False; MainThread.Reentrant := False; MainThread.NotifyRunning := False;
  MainThread.UnexpectedCompletion := False; MainThread.RaiseEvaluate := False; MainThread.RaiseModify := False;
  MainThread.EvalText := '42'; MainThread.FailAdd := False; MainThread.FailRemove := False;
  MainThread.ThrowAfterAdd := False;
end;
procedure TestAll;
var
  LRequest, LPrepared: TDAIEvaluationRequest;
  LJson, LStatus: TJSONObject;
  LId, LOldId: string;
  LBefore, I: Integer;
  LWorker: TThread;
  LThreadObject: TFakeThread;
  LThreads: TArray<TFakeThread>;
  LProcess: TFakeProcess;
  LOriginal: IOTAProcess;
begin
  LRequest := Request(''); Rejected(LRequest);
  LRequest := Request('x' + #0); Rejected(LRequest);
  LRequest := Request; LRequest.SideEffects := 'bad'; Rejected(LRequest);
  LRequest := Request; LRequest.FormatSpecifiers := 'ä'; Rejected(LRequest);
  LRequest := Request; LRequest.SourceFile := 'Unit1.pas'; Rejected(LRequest);
  LRequest := Request; LRequest.Line := 1; Rejected(LRequest);
  LRequest := Request; LRequest.MaximumCharacters := 65537; Rejected(LRequest);
  LRequest := Request; LRequest.TimeoutMs := 99; Rejected(LRequest);
  LRequest := Request; LRequest.SideEffects := 'all'; Rejected(LRequest, True);
  Rejected(Request, True, '');
